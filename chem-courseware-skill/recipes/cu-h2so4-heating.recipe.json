      "target": "alcohol-burner.heatZone",
      "targetRadius": 0.72,
      "overlapPadding": 0.28,
      "onComplete": "start-reaction"
    },
    {
      "id": "finish-reaction",
      "type": "reaction-progress",
      "reaction": "hot-concentrated-h2so4-copper",
      "successPhase": "result"
